# Server-only variables. Leave empty for ordinary local browsing and unit tests.
# A real /api/notify submission with configured credentials writes private storage
# and can send production notifications. Use isolated test services for testing.
BLOB_READ_WRITE_TOKEN=
DISCORD_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_URL=

# Public GA4 measurement ID. Empty disables analytics; localhost/previews stay off.
# Production activation also requires the documented GA4 stream settings.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
